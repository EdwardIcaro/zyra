{
  "name": "@zyra/db",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "migrate": "node ../../../node_modules/prisma/build/index.js migrate dev --schema schema.prisma",
    "generate": "node ../../../node_modules/prisma/build/index.js generate --schema schema.prisma",
    "studio": "node ../../../node_modules/prisma/build/index.js studio --schema schema.prisma",
    "push": "node ../../../node_modules/prisma/build/index.js db push --schema schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2"
  }
}
